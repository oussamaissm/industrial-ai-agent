# Copy this file to .env and fill in your API key
GROQ_API_KEY=your_groq_api_key_here

# Which factory the agent talks to: simulator (default) | openfactory
FACTORY_BACKEND=simulator
# How tools reach the factory: direct (in-process) | mcp (through the MCP server)
FACTORY_TOOL_TRANSPORT=direct

# Open Factory Demo Factory REST API (docker compose --profile openfactory up -d openfactory-api)
OPENFACTORY_BASE_URL=http://localhost:8000
# MCP server used when FACTORY_TOOL_TRANSPORT=mcp
MCP_SERVER_URL=http://localhost:8765/mcp
